// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String  @id @default(uuid())
  username  String  @unique
  password  String  @db.VarChar(120)
  email     String  @db.VarChar(320)
  firstName String?
  lastName  String?
  role      Role    @default(USER)

  posts         Post[]
  postComments  PostComment[]
  eventComments EventComment[]
  event         Event[]

  postReactions         PostReaction[]
  postCommentReactions  PostCommentReaction[]
  eventRsvps            EventRsvp[]
  eventCommentReactions EventCommentReaction[]
  projects              Project[]
}

model Post {
  id      String @id @default(uuid())
  title   String
  slug    String @unique
  excerpt String
  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  comments  PostComment[]
  reactions PostReaction[]

  @@index([authorId])
  @@index([createdAt])
}

model PostComment {
  id String @id @default(uuid())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parentId String?
  parent   PostComment?  @relation("PostCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  PostComment[] @relation("PostCommentReplies")

  reactions PostCommentReaction[]

  body      String
  anonymous Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
  @@index([parentId])
}

model Event {
  id   String @id @default(uuid())
  slug String @unique

  title       String
  host        String
  startTime   String
  endTime     String?
  date        DateTime
  location    String?
  description String?
  excerpt     String?

  authorId String
  author   User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments EventComment[]
  rsvps    EventRsvp[]
}

model EventCommentReaction {
  id   String       @id @default(uuid())
  type ReactionType

  commentId String
  comment   EventComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([userId])
}

// going / not going, one per user per event
model EventRsvp {
  id     String     @id @default(uuid())
  status RsvpStatus

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
  @@index([userId])
}

model EventComment {
  id String @id @default(uuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parentId String?
  parent   EventComment?  @relation("EventCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  EventComment[] @relation("EventCommentReplies")

  reactions EventCommentReaction[]

  body      String
  anonymous Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, createdAt])
  @@index([authorId, createdAt])
  @@index([parentId])
}

// thumbs up / thumbs down, one per user per post or comment
model PostReaction {
  id   String       @id @default(uuid())
  type ReactionType

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

model PostCommentReaction {
  id   String       @id @default(uuid())
  type ReactionType

  commentId String
  comment   PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([userId])
}

enum ReactionType {
  LIKE
  DISLIKE
}

// a card on the /projects hub: web projects, games, steam mods, game servers, tools...
model Project {
  id          String @id @default(uuid())
  title       String
  description String // optional on the site, saved as "" when empty

  categoryId String
  category   ProjectCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  url       String? // main link: a site, steam workshop page, game page or a page on this site like /pomodoro
  linkLabel String? // optional text for the main button, otherwise it's worked out from the link
  sourceUrl String? // github etc.
  imageUrl  String?
  pinned    Boolean  @default(false)
  position  Int? // set when the admin drags projects into a custom order, null = automatic order
  date      DateTime @default(now()) // "newest first" sorts by this, editable so projects can be back-dated

  // game servers (any category): address, running switch and live status
  isServer      Boolean     @default(false)
  serverGame    ServerGame?
  serverAddress String?
  serverRunning Boolean     @default(false) // flipped on while the server is up

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([categoryId])
}

// categories on the projects page, added / deleted from the site
// "other" can't be deleted: projects from deleted categories move there
model ProjectCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique // used in the filter link, /projects?type=steam-mods
  createdAt DateTime  @default(now())
  projects  Project[]
}

enum ServerGame {
  MINECRAFT
  RUST
  OTHER
}

enum RsvpStatus {
  GOING
  NOT_GOING
}

enum Role {
  USER
  ADMIN
  TRISTON
}
